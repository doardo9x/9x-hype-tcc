@model ninexhype.ViewModels.IndexVM
@{
    ViewData["Title"] = "Home";
}

<!-- Header-->
<!-- Navigation-->
<!------------------- HEADER ------------------->
<div class="bg-carousel" id="bgCarousel">
    <div class="shadow-header">
        <header>
            <div class="HeaderLogo center desktop">
                <a asp-action="index" class="fs-1 ninexLogo center">9xHype</a>
            </div>
            <div class="HeaderLogo center mobile">
                <a href="index.html" class="fs-1 ninexLogo center">9x</a>
            </div>

            <div class="HeaderSearchBar center">
                <div class="contSearchBar">
                    <input class="searchBar" type="text" placeholder="Digite o nome do produto.">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                        class="bi bi-search" viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 
                               3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1z
                               M12 6.5a5.5 5.5 0 1 1-11 0 
                               5.5 5.5 0 0 1 11 0" />
                    </svg>
                </div>
            </div>

            <div class="HeaderIcons center">
                <a class="icons" href="">
                    <i class="icones fa-solid fa-cart-shopping"></i>
                </a>
                <a class="icons" href="/PagFavoritos/pagFavoritos.html">
                    <i class="icones fa-regular fa-heart"></i>
                </a>
                <div class="icons">
                    <partial name="_LoginPartial">
                </div>
            </div>

            <!-- mobile -->
            <div class="contMobile-Icons">
                <div class="HeaderIcons-mobile center">
                    <a class="icons" href="">
                        <i class="icones fa-solid fa-cart-shopping"></i>
                    </a>
                    <a class="icons" href="">
                        <i class="icones fa-regular fa-heart"></i>
                    </a>
                    <a class="icons" href="">
                        <i class="icones fa-regular fa-circle-user"></i>
                    </a>
                </div>

                <!-- Botão do menu -->
                <button class="btn btn-secondary" type="button" id="menuToggle">
                    <i class="fa-solid fa-bars"></i>
                </button>

                <!-- Sidebar -->
                <div id="sidebar" class="sidebar">
                    <button class="close-btn" id="closeSidebar">&times;</button>
                    <a href="#">HOMEM</a>
                    <a href="#">MULHER</a>
                    <a href="#">ACESSÓRIOS</a>
                    <a href="#">PEÇAS</a>
                    <a href="#">MARCAS</a>
                </div>
            </div>
        </header>

        <nav class="nav-computer center">
            <div class="dropdown">
                <button class="btn btn-secondary dropdown botoes" type="button">
                    HOMEM
                </button>
            </div>
            <div class="dropdown">
                <button class="btn btn-secondary dropdown botoes" type="button">
                    MULHER
                </button>
            </div>
            <div class="dropdown">
                <button class="btn btn-secondary dropdown-toggle botoes" type="button" id="dropdownMenuButton"
                    data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    ACESSÓRIOS ̬
                </button>
                <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#">Alguma ação</a>
                    <a class="dropdown-item" href="#">Outra ação</a>
                    <a class="dropdown-item" href="#">Alguma coisa aqui</a>
                </div>
            </div>
            <div class="dropdown">
                <button class="btn btn-secondary dropdown-toggle botoes" type="button" id="dropdownMenuButton"
                    data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    PEÇAS ̬
                </button>
                <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#">Alguma ação</a>
                    <a class="dropdown-item" href="#">Outra ação</a>
                    <a class="dropdown-item" href="#">Alguma coisa aqui</a>
                </div>
            </div>
            <div class="dropdown">
                <button class="btn btn-secondary dropdown-toggle botoes" type="button" id="dropdownMenuButton"
                    data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    MARCAS ̬
                </button>
                <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#">Alguma ação</a>
                    <a class="dropdown-item" href="#">Outra ação</a>
                    <a class="dropdown-item" href="#">Alguma coisa aqui</a>
                </div>
            </div>
        </nav>
    </div>

    <div class="container-BG center"></div>
</div>

<!--------------------- SITE --------------------->
<div class="w100 center">
    <div class="container-body">
        <div class="Produtos">
            <div class="cont-Sneakers">
                <div class="Sneakers fs-1">DESTAQUES</div>
                <div class="slideshow-container">
                    @foreach (Produto produto in Model.Destaques)
                    {
                        <div class="slideshow fade ativo">
                            <div class="numeracao">@produto.Id</div>
                            <img src="@(produto.Fotos.Count <= 0 ? 
                                                                        "https://dummyimage.com/450x300/dee2e6/6c757d.jpg" :
                                                                        produto.Fotos[0].ArquivoFoto)" alt="@produto.Nome" />
                            <div class="legenda">
                                <div class="fs-7 w100 NomeDestaque">@produto.Nome</div>
                                <div class="fs-7 w100 valorVendaDestaque">R$@produto.ValorVenda</div>
                            </div>
                        </div>
                        <a class="prev" onclick="plusSlides(-1)">&#10094;</a>
                        <a class="next" onclick="plusSlides(1)">&#10095;</a>
                    }
                </div>
                <div class="paginacao">
                    @for (int i = 0; i < Model.Destaques.Count; i++)
                    {
                        <span class="dot" onclick="currentSlide(@i)"></span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Section-->
<section class="contRoupa">
    <div class="carrosselRoupas">
        @foreach (Produto produto in Model.Produtos.Where(p => p.CategoriaId == 1))
        {
            <div class="card cardCarrossel" style="width: 12rem;">
                <a asp-action="Produto" asp-route-id="@produto.Id">
                    <img src="@(produto.Fotos.Count <= 0 ? "https://dummyimage.com/450x300/dee2e6/6c757d.jpg" : produto.Fotos[0].ArquivoFoto)" alt="@produto.Nome" class="card-img-top">
                </a>
                <div class="card-body">
                    <p class="card-text nomeProdutoCarrossel">@produto.Nome</p>
                    <p class="card-text precoProduto">R$ @produto.ValorVenda.ToString("N2")</p>
                </div>
            </div>
        }

    </div>
</section>
