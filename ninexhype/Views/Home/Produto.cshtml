                            <p>R$ 2.500,00</p>
                        </option>
                        <option value="44">
                            <p>44</p>
                            <p>R$ 2.300,00</p>
                        </option>
                        <option value="43" selected>
                            <p>43</p>
                            <p>R$ 2.300,00</p>
                        </option>
                        <option value="41">
                            <p>41</p>
                            <p>R$ 2.700,00</p>
                        </option>
                        <option value="39">
                            <p>39</p>
                            <p>R$ 2.500,00</p>
                        </option>
                        <option value="37">
                            <p>37</p>
                            <p>R$ 2.200,00</p>
                        </option>
                        <option value="35">
                            <p>35</p>
                            <p>R$ 2.100,00</p>
                        </option>
