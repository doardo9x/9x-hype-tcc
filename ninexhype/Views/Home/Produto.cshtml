<link rel="stylesheet" href="~/css/produto.css">

@model ninexhype.ViewModels.ProdutoVM
@{
    ViewData["Title"] = "Detalhes do Produto";
}

<div class="pagProduto">

    <div class="headerPagProduto">
        <h1 class="nomeProduto">@Model.Produto.Nome</h1>
        <a class="botaoVoltar t-nome" href="#voltar">Voltar</a>
    </div>

    <!-- Carrossel -->
    <div class="carrossel">
        <div class="carrossel-pop-up">
            <div class="carousel-Modal">
                <ul class="carousel__list-Modal">
                    @* <li class="carousel__item-Modal" data-pos="-2">1</li> *@
                    <li class="carousel__item-Modal" data-pos="-1">2</li>
                    <li class="carousel__item-Modal" data-pos="0">3</li>
                    <li class="carousel__item-Modal" data-pos="1">4</li>
                    @* <li class="carousel__item-Modal" data-pos="1">5</li> *@
                </ul>
            </div>
        </div>
    </div> <!--Fim Carrossel-->

    <div class="opcoesCores">
        <div class="opcaoCOr">
            <input type="radio" name="cor" value="preto" id="preto">
            <label class="cor" for="preto">Preto</label>
        </div>

        <div class="opcaoCor">
            <input type="radio" name="cor" value="branco" id="branco">
            <label class="cor" for="branco">Branco</label>
        </div>

        <div class="opcaoCor">
            <input type="radio" name="cor" value="roxo" id="roxo">
            <label class="cor" for="roxo">Roxo</label>
        </div>

    </div>

