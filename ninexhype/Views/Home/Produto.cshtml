@model ninexhype.ViewModels.ProdutoVM
@{
    ViewData["Title"] = "Detalhes do Produto";
}

<div class="pagProduto">
    @{
        ViewData["Title"] = "Detalhes do Produto";
    }

    <div class="pagProduto">

        <!-- Carrossel -->
        <div class="carrossel">
            <div id="carouselProduto" class="carousel slide" data-bs-ride="carousel">

                <!-- Indicadores (bolinhas) -->
                <div class="carousel-indicators">
                    @for (int i = 0; i < Model.Produto.Fotos.Count; i++)
                    {
                        <button type="button" data-bs-target="#carouselProduto" data-bs-slide-to="@i"
                            class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")"
                            aria-label="Slide @(i + 1)"></button>
                    }
                </div>

                <!-- Itens do carrossel -->
                <div class="carousel-inner">
                    @for (int i = 0; i < Model.Produto.Fotos.Count; i++)
                    {
                        var foto = Model.Produto.Fotos[i];
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@foto.ArquivoFoto" class="d-block w-100" alt="@Model.Produto.Nome"
                                style="object-fit: contain; max-height: 600px;">
                        </div>
                    }
                </div>

                <!-- Controles -->
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselProduto"
                    data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Anterior</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carouselProduto"
                    data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Próximo</span>
                </button>
            </div>
        </div>
        <!-- Fim Carrossel -->



        <!-- Info Produto -->
        <div class="infoProduto">

            <div class="tamanhoProduto desktop">

                <div class="OpcoesTamanho">
                    <button class="btnOpcoesTamanho">
                        <div class="txtOpcoes">39</div>
                        <div class="txtOpcoes">R$ @((Model.Produto.ValorVenda * 1.10M).ToString("N2"))</div>
                    </button>
                </div>
                <div class="OpcoesTamanho">
                    <button class="btnOpcoesTamanho">
                        <div class="txtOpcoes">40</div>
                        <div class="txtOpcoes">R$ @((Model.Produto.ValorVenda * 1.10M).ToString("N2"))</div>
                    </button>
                </div>
                <div class="OpcoesTamanho">
                    <button class="btnOpcoesTamanho">
                        <div class="txtOpcoes">41</div>
                        <div class="txtOpcoes">R$ @((Model.Produto.ValorVenda * 1.10M).ToString("N2"))</div>
                    </button>
                </div>
                <div class="OpcoesTamanho">
                    <button class="btnOpcoesTamanho">
                        <div class="txtOpcoes">42</div>
                        <div class="txtOpcoes">R$ @((Model.Produto.ValorVenda * 1.10M).ToString("N2"))</div>
                    </button>
                </div>
                <div class="OpcoesTamanho">
                    <button class="btnOpcoesTamanho">
                        <div class="txtOpcoes">43</div>
                        <div class="txtOpcoes">R$ @((Model.Produto.ValorVenda * 1.10M).ToString("N2"))</div>
                    </button>
                </div>
                <div class="OpcoesTamanho">
