    <!-- Related items section-->
    <section class="relacionados">
        <div class="container px-4 px-lg-5 mt-5">
            <h2 class="titlePadrao">Produtos Semelhantes</h2>
            <div class="row gx-4 gx-lg-5 row-cols-2 row-cols-md-3 row-cols-xl-4 justify-content-center">
                @foreach (Produto produto in Model.Semelhantes)
                {
                    <div class="col mb-5">
                        <div class="card h-100">
                            <!-- Product image-->
                            <div class="cont-imgTop"><img class="card-img-top"
                                    src="@(produto.Fotos.Count == 0 ?
                                                                                                                                               "https://dummyimage.com/450x300/dee2e6/6c757d.jpg"
                                                                                                                                               : produto.Fotos[0].ArquivoFoto)" alt="@produto.Nome" />
                            </div <!-- Product details-->
                            <div class="card-body p-4">
                                <div class="text-center">
                                    <!-- Product name-->
                                    <h5 class="fw-bolder">@produto.Nome</h5>
                                    <!-- Product price-->
                                    @produto.ValorVenda.ToString("N2")
                                </div>
                            </div>
                            <!-- Product actions-->
                            <div class="card-footer p-4 pt-0 border-top-0 bg-transparent">
                                <div class="text-center">
                                    <a class="btn btn-outline-dark mt-auto" asp-controller="Home" asp-action="Produto"
                                        asp-route-id="@produto.Id">
                                        Detalhes</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>


