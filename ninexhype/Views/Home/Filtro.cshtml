@model IEnumerable<ninexhype.Models.Produto>

@{
    ViewData["Title"] = "Filtro " + ViewBag.Categoria;
}

<h2>@ViewBag.Categoria</h2>
<hr />

@if (Model == null || !Model.Any())
{
    <div class="alert alert-warning text-center mt-4" role="alert">
        Nenhum produto disponível nesta categoria no momento.
    </div>
}
else
{
    <div class="row">

        @foreach (var produto in Model)
        {
            <div class="col-md-3 mb-4">
                <div class="card h-100 shadow-sm">
                    <a href="@Url.Action("Produto", "Home", new { id = produto.Id })" class="text-decoration-none text-dark">
                        @if (produto.Fotos != null && produto.Fotos.Any())
                        {
                            <img src="@produto.Fotos.First().ArquivoFoto" class="card-img-top" alt="@produto.Nome">
                        }
                        else
                        {
                            <img src="~/img/sem-foto.png" class="card-img-top" alt="Sem imagem disponível">
                        }

                        <div class="card-body">
                            <h5 class="card-title">@produto.Nome</h5>
                            <p class="card-text">R$ @produto.ValorVenda.ToString("F2")</p>
                        </div>
                    </a>
                    <div class="card-footer bg-transparent border-0">
                        <a href="@Url.Action("Produto", "Home", new { id = produto.Id })" class="btn btn-dark w-100">Ver
                            detalhes</a>
                    </div>
                </div>
            </div>
        }


    </div>
}
