@model ninexhype.Models.Usuario
@{
    ViewData["Title"] = "Editar Perfil";
}

<div class="container mt-4">
    <h2>Editar Perfil</h2>
    <hr />

    <form asp-action="Editar" method="post" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-4 text-center">
                <label class="form-label">Foto de Perfil</label>
                <div class="mb-3">
                    @if (!string.IsNullOrEmpty(Model.Foto))
                    {
                        <img src="@Model.Foto" alt="Foto de Perfil" class="img-fluid rounded-circle mb-2" />
                    }
                    else
                    {
                        <img src="/img/usuarios/default.png" alt="Foto de Perfil" class="img-fluid rounded-circle mb-2" />
                    }
                    <input type="file" name="Foto" class="form-control" />
                </div>
            </div>

            <div class="col-md-8">
                <div class="mb-3">
                    <label class="form-label">Nome</label>
                    <input asp-for="Nome" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">CPF</label>
                    <input asp-for="Cpf" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Data de Nascimento</label>
                    <input asp-for="DataNascimento" class="form-control" type="date" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Gênero</label>
                    <input asp-for="Genero" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Telefone Alternativo</label>
                    <input asp-for="TelefoneAlternativo" class="form-control" />
                </div>

                @if (Model.Endereco != null)
                {
                    <hr />
                    <h5>Endereço</h5>
                    <div class="mb-3">
                        <label class="form-label">Rua</label>
                        <input asp-for="Endereco.Logradouro" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Número</label>
                        <input asp-for="Endereco.Numero" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Complemento</label>
                        <input asp-for="Endereco.Complemento" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Bairro</label>
                        <input asp-for="Endereco.Bairro" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cidade</label>
                        <input asp-for="Endereco.Cidade" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Estado</label>
                        <input asp-for="Endereco.Estado" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">CEP</label>
                        <input asp-for="Endereco.Cep" class="form-control" />
                    </div>
                }

                <div class="mt-3">
                    <button type="submit" class="btn btn-success">Salvar</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </div>
        </div>
    </form>

    <div asp-validation-summary="All" class="text-danger mt-2"></div>
</div>
