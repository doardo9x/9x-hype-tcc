<link rel="stylesheet" href="~/css/PagCarrinho.css">

@model ninexhype.Models.Carrinho

@{
    ViewData["Title"] = "Carrinho";
}

<div class="container">

    <div class="campoTitulo">
        <h2 class="letraBranca fs-1">@ViewData["Title"]</h2>
    </div>

    @if (Model.Itens.Count == 0)
    {
        <p class="letraBranca fs-5">Seu carrinho está vazio 😢</p>
    }
    else
    {

        <div class="main">
            <h1 class="tituloProdutos"> Produto (1)</h1>

            @foreach (var item in Model.Itens)
            {
                <div class="produtoCarrinho">
                    <div class="fotoProduto"></div>

                    <div class="infoProduto">
                        <div class="textoInfoProduto letraBranca fs-1">lorem</div>

                        <div class="textoInfoProduto letraBranca fs-4">lorem</div>

                        <div class="textoInfoProduto letraBranca fs-4">lorem</div>

                        <div class="textoInfoProduto letraBranca fs-4">lorem</div>

                        <div class="textoInfoProduto letraBranca fs-4">lorem</div>

                        <div class="opcoesProduto letraBranca fs-4">
                            <div class="quantidadeProduto">
                                <form asp-action="AtualizarQuantidade" method="post" class="d-flex">
                                    <h1 class="letraBranca fs-5">Quantidade:</h1>
                                    <input type="hidden" name="itemId" value="@item.Id" />
                                    <input type="number" name="novaQuantidade" value="@item.Quantidade" min="1"
                                        class="form-control w-50" />
                                    <button type="submit" class="btn btn-sm btn-primary ms-2">Atualizar</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <h4 class="totalCarrinho">Total: <strong>R$ @ViewBag.Total.ToString("N2")</strong></h4>

        <form asp-action="Limpar" method="post">
            <button type="submit" class="btn btn-warning">Limpar Carrinho</button>
        </form>
    }
</div>
