            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Destaque)
            </dd>

            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.Genero)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Genero)
            </dd>
        </div>


    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> 
    <a asp-action="Index">Back to List</a>
</div>
