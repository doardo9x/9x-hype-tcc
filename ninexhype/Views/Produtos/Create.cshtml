@model ninexhype.Models.Produto

@{
    ViewData["Title"] = "Create";
}

<link rel="stylesheet" href="~/css/CreateProduto.css">

<div class="container">
    <div class="areaTitulo">
        <h1 class="detalhesTitulo">Adicionar Produto</h1>
    </div>

    <div class="main">
        <div class="quadradoEsq">
            <form asp-action="Create">
                <div class="primeiraLinha">
                    <label asp-for="Nome" class="tituloCampo fs-3"></label>
                    <input asp-for="Nome" class=" inputCampo" placeholder="Insira o Nome Produto" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="segundaLinha">
                    <div class="campoDuplo">
                        <label asp-for="Categoria" class="tituloCampo fs-3"></label>
                        <select asp-for="CategoriaId" class=" inputCampo" asp-items="ViewBag.CategoriaId"></select>
                    </div>
                    <div class="campoDuplo">
                        <label asp-for="Genero" class="tituloCampo fs-3"></label>
                        <select asp-for="Genero" asp-items="Html.GetEnumSelectList<Genero>()"
                            class="inputCampo"></select>
                    </div>

                </div>

                <div class="terceiraLinha">
                    <div class="campoDuplo">
                        <label asp-for="ValorVenda" class=" tituloCampo fs-3"></label>
                        <input asp-for="ValorVenda" class=" inputCampo" placeholder="Defina o Valor de Venda" />
                        <span asp-validation-for="ValorVenda" class="text-danger"></span>
                    </div>
                    <div class="campoDuplo">
                        <label asp-for="ValorCusto" class=" tituloCampo fs-3"></label>
                        <input asp-for="ValorCusto" class=" inputCampo" placeholder="Informe o Valor de Custo" />
                        <span asp-validation-for="ValorCusto" class="text-danger"></span>
                    </div>
                </div>

                <div class="quintaLinha">
                    <div class="form-group">
                        <label asp-for="QtdeEstoque" class=" tituloCampo fs-3"></label>
                        <input asp-for="QtdeEstoque" class=" inputCampo"
                            placeholder="Informe a Quantidade em Estoque" />
                        <span asp-validation-for="QtdeEstoque" class="text-danger"></span>
                    </div>
                </div>
                <div class="quintaLinha">
                    <label asp-for="Descricao" class=" tituloCampo fs-3"></label>
                    <textarea asp-for="Descricao" class="inputCampo" rows="5"></textarea>
                    <span asp-validation-for="Descricao" class="text-danger"></span>
                </div>

                <div class="form-group oculto">
                    <input type="submit" value="Criar" class="btn btn-primary botaoCreate" />
                </div>
            </form>

        </div>
        <div class="quadradoDir">
            <!-- FOTO GRANDE -->
            <div class="fotoGrande">
                <input type="file" id="uploadGrande1" accept="image/*" hidden>
                <label for="uploadGrande1" class="uploadArea">
                    <i class="fa-solid fa-circle-plus fa-2x" style="color: #515151;"></i>
                </label>
                <img id="previewGrande1" class="previewImg" style="display:none;">
            </div>

            <div class="fotoGrande">
                <input type="file" id="uploadGrande2" accept="image/*" hidden>
                <label for="uploadGrande2" class="uploadArea">
                    <i class="fa-solid fa-circle-plus fa-2x" style="color: #515151;"></i>
                </label>
                <img id="previewGrande2" class="previewImg" style="display:none;">
            </div>

            <!-- FOTOS PEQUENAS -->
            <div class="divFotoPequena">
                <div class="fotoPequena">
                    <input type="file" id="uploadPequena1" accept="image/*" hidden>
                    <label for="uploadPequena1" class="uploadArea">
                        <i class="fa-solid fa-circle-plus fa-2x" style="color: #515151;"></i>
                    </label>
                    <img id="previewPequena1" class="previewImg" style="display:none;">
                </div>

                <div class="fotoPequena">
                    <input type="file" id="uploadPequena2" accept="image/*" hidden>
                    <label for="uploadPequena2" class="uploadArea">
                        <i class="fa-solid fa-circle-plus fa-2x" style="color: #515151;"></i>
                    </label>
                    <img id="previewPequena2" class="previewImg" style="display:none;">
                </div>
            </div>

            <div class="form-group botaoMobile">
                <input type="submit" value="Criar" class="btn btn-primary botaoCreateMobile" />
            </div>
        </div>
    </div>

    <div class="botaoVoltar">
        <a asp-action="Index" class="botaoVoltarLista">Back to List</a>
    </div>
</div>

<script src="~/js/CreateProduto.js"></script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
