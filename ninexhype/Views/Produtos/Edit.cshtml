<link rel="stylesheet" href="~/css/EditProduto.css">

@model ninexhype.Models.Produto

@{
    ViewData["Title"] = "Edit";
}
<div class="container">

    <div class="areaTitulo">
        <h1 class="detalhesTitulo">Editar Produto</h1>
    </div>

    <div class="main">
        <div class="quadradoEsq">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />

                <div class="primeiraLinha">
                    <div class="form-group">
                        <label asp-for="Nome" class="control-label tituloCampo fs-3"></label>
                        <input asp-for="Nome" class="form-control inputCampo" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                </div>

                <div class="segundaLinha">
                    <div class="form-group campoDuplo">
                        <label asp-for="Categoria" class="control-label tituloCampo fs-3"></label>
                        <select asp-for="CategoriaId" class="form-control inputCampo"
                            asp-items="ViewBag.CategoriaId"></select>
                        <span asp-validation-for="CategoriaId" class="text-danger"></span>
                    </div>

                    <div class="form-group campoDuplo">
                        <label asp-for="Genero" class="control-label tituloCampo fs-3"></label>
                        <select asp-for="Genero" class="form-contro inputCampo" asp-items="ViewBag.Generos"></select>
                        <span asp-validation-for="Genero" class="text-danger"></span>
                    </div>
                </div>

                <div class="terceiraLinha">
                    <div class="form-group campoDuplo">
                        <label asp-for="ValorCusto" class="control-label tituloCampo fs-3"></label>
                        <input asp-for="ValorCusto" class="form-control inputCampo" />
                        <span asp-validation-for="ValorCusto" class="text-danger"></span>
                    </div>

                    <div class="form-group campoDuplo">
                        <label asp-for="ValorVenda" class="control-label tituloCampo fs-3"></label>
                        <input asp-for="ValorVenda" class="form-control inputCampo" />
                        <span asp-validation-for="ValorVenda" class="text-danger"></span>
                    </div>
                </div>

                <div class="quintaLinha">
                    <div class="form-group">
                        <label asp-for="QtdeEstoque" class="control-label tituloCampo fs-3"></label>
                        <input asp-for="QtdeEstoque" class="form-control inputCampo" />
                        <span asp-validation-for="QtdeEstoque" class="text-danger"></span>
                    </div>
                </div>

                <div class="quintaLinha">
                    <div class="form-group">
                        <label asp-for="Descricao" class="control-label tituloCampo fs-3"></label>
                        <input asp-for="Descricao" class="form-control inputCampo" />
                        <span asp-validation-for="Descricao" class="text-danger"></span>
                    </div>
                </div>

                <div class="sextaLinha">
                    <div class="botaoSalvar">
                        <input type="submit" value="Save" class="botaoSalvarTextoDentroInferno" />
                    </div>
                </div>
            </form>

        </div>

        <div class="quadradoDir">
            <!-- FOTO GRANDE -->
            <div class="fotoGrande">
                <input type="file" id="uploadGrande1" accept="image/*" hidden>
                <label for="uploadGrande1" class="uploadArea">
                    <i class="fa-solid fa-circle-plus fa-2x" style="color: #515151;"></i>
                </label>
                <img id="previewGrande1" class="previewImg" style="display:none;">
            </div>

            <div class="fotoGrande">
                <input type="file" id="uploadGrande2" accept="image/*" hidden>
                <label for="uploadGrande2" class="uploadArea">
                    <i class="fa-solid fa-circle-plus fa-2x" style="color: #515151;"></i>
                </label>
                <img id="previewGrande2" class="previewImg" style="display:none;">
            </div>

            <!-- FOTOS PEQUENAS -->
            <div class="divFotoPequena">
                <div class="fotoPequena">
                    <input type="file" id="uploadPequena1" accept="image/*" hidden>
                    <label for="uploadPequena1" class="uploadArea">
                        <i class="fa-solid fa-circle-plus fa-2x" style="color: #515151;"></i>
                    </label>
                    <img id="previewPequena1" class="previewImg" style="display:none;">
                </div>

                <div class="fotoPequena">
                    <input type="file" id="uploadPequena2" accept="image/*" hidden>
                    <label for="uploadPequena2" class="uploadArea">
                        <i class="fa-solid fa-circle-plus fa-2x" style="color: #515151;"></i>
                    </label>
                    <img id="previewPequena2" class="previewImg" style="display:none;">
                </div>
            </div>
        </div>
    </div>

    <div class="botoes">
        @* <div class="botaoSalvar">
            <input type="submit" value="Save" class="botaoSalvarTextoDentroInferno" />
        </div> *@

        <div class="botaoVoltar">
            <a asp-action="Index" class="botaoVoltarLista">Voltar</a>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
