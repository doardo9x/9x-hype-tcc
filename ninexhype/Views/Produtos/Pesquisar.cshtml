@model List<ninexhype.Models.Produto>

<h2>Resultados da Pesquisa</h2>

@if (Model.Count == 0)
{
    <p>Nenhum produto encontrado.</p>
}
else
{
    <div class="row">
        @foreach (var produto in Model)
        {
            <div class="col-md-3 mb-4">
                <div class="card">
                    <a asp-action="Produto" asp-route-id="@produto.Id">
                        <img class="card-img-top"
                             src="@(produto.Fotos.Count == 0 
                                 ? "https://dummyimage.com/450x300/dee2e6/6c757d.jpg"
                                 : produto.Fotos[0].ArquivoFoto)" 
                             alt="@produto.Nome" />
                    </a>

                    <div class="card-body">
                        <h5 class="card-title">@produto.Nome</h5>
                        <p>R$ @produto.ValorVenda.ToString("N2")</p>
                    </div>
                </div>
            </div>
        }
    </div>
}
