@model ninexhype.Models.Categoria

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<link rel="stylesheet" href="~/css/CreateCategoria.css">


<div class="cont-body">
    <h1>Criar Categoria</h1>
    <div class="main">
        <div class="col-md-4 ">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="Nome" class="tituloCampo fs-3"></label>
                    <input asp-for="Nome" class="inputCampo" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="TipoRoupaId" class="tituloCampo fs-3"> Tipo do Produto</label>
                    <select asp-for="TipoRoupaId" class="inputCampo" asp-items="ViewBag.TipoRoupaId"></select>
                </div>

                <div class="form-group divBotoes">
                    <input type="submit" value="Create" class="btn botaoCreate" />
                    <a asp-action="Index" class="btn botaoCreate">Voltar</a>
                </div>
            </form>



        </div>
    </div>
</div>
